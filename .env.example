# Plaid server-side ingestion (never expose these with NEXT_PUBLIC_ prefixes)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 32 random bytes encoded as base64
FINANCIAL_TOKEN_ENCRYPTION_KEY=
# Cloudflare Turnstile. The site key is public; secrets remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend/Svix webhook signing secret (server-only).
RESEND_WEBHOOK_SIGNING_SECRET=
